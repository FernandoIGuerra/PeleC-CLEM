max_step  = 100000000
stop_time = 10.0e-4          # 0.4 ms, ~3 flow-through times

# ---------------------------------------------------------------- geometry --
# CGS. 125 x 15 x 5 mm combustor, spanwise-periodic.
geometry.is_periodic = 0 0 1
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0   0.0  0.0
geometry.prob_hi     = 12.5  1.5  0.5

amr.n_cell           = 400 48 16       # dx = 0.3125 mm (paper's coarse grid)

# --------------------------------------------------------------------- BCs --
# xlo   : supersonic vitiated-air inflow            (bcnormal)
# ylo   : adiabatic no-slip wall + H2 injector hole (bcnormal)
# yhi   : adiabatic no-slip wall
# xhi   : supersonic outflow (first-order extrapolation)
# z     : periodic
pelec.lo_bc = "UserBC"  "UserBC"      "Interior"
pelec.hi_bc = "FOExtrap" "NoSlipWall"  "Interior"

# ----------------------------------------------------------------- physics --
pelec.do_hydro     = 1
pelec.do_mol       = 1        # REQUIRED by CLEM (see header), also the paper's
pelec.mol_iorder   = 2
pelec.diffuse_vel  = 1
pelec.diffuse_temp = 1
pelec.diffuse_spec = 1        # LES owns resolved diffusion (freeze_species=0)
pelec.diffuse_enth = 1
pelec.do_react     = 0
pelec.chem_integrator = "ReactorNull"


pelec.do_les       = 1
pelec.Cs           = 0.16     # classical Smagorinsky constant; MUST be > 0 or
                              # clem.do_stir aborts (nu_t == 0 => no eddy ever)

# ------------------------------------------------------------- time stepping -
pelec.cfl         = 0.1       # paper's CFL
pelec.init_shrink = 0.1
pelec.change_max  = 1.05
pelec.dt_cutoff   = 1.e-14

# ----------------------------------------------------------------- verbosity -
pelec.v            = 1
amr.v              = 1
pelec.sum_interval = 10
amr.data_log       = datlog

# -------------------------------------------------------------------- AMR ---
# Single level: see item 1 of the header. Do NOT raise this while CLEM is on.
amr.max_level       = 0
amr.blocking_factor = 16
amr.max_grid_size   = 32

# --------------------------------------------------------------------- CLEM -
clem.verbose = 1
clem.freeze_species = 1
clem.pressure_coupling  = 1   # LES -> SGS isentropic pressure work
clem.couple_back        = 1   # SGS -> LES filtered (rho Y_k, rho e)
clem.couple_back_energy = 1   # mode 1, conserved delta (ClemManager.H:54-63)
clem.vol_renorm         = 1   # rescale each line to V_cell after the splice
clem.regrid_int         = 1
clem.do_react = 1            # non-reacting case
clem.do_diffusion           = 1
clem.diffusion_cfl          = 0.5
clem.diffusion_max_substeps = 1000
clem.do_stir = 1
cvode.solve_type = "GMRES"
# Particle plotfiles (plt_clem_*/particles). Expensive in 3D: 3.69M elements.
clem.plot_int = 0

# ------------------------------------------------------------------ output --
amr.checkpoint_files_output = 1
amr.check_file = chk
amr.check_per  = 5.0e-5

amr.plot_files_output = 1
amr.plot_file = plt_React
amr.plot_per  = 1.0e-5
amr.plot_vars        = density Temp
amr.derive_plot_vars = x_velocity y_velocity z_velocity magvel magvort pressure MachNumber soundspeed
pelec.plot_massfrac = 1
pelec.plot_rhoy     = 0

# ------------------------------------------------------- problem parameters --
# Table 1 of the paper, Case 1. CGS: 1 atm = 1.01325e6 dyn/cm^2.
prob.p_in   = 1.01325e6      # 1 atm
prob.T_in   = 1000.0         # K
prob.u_in   = 9.30e4         # 930 m/s -> M = 1.5
prob.YO2_in = 0.23
prob.YN2_in = 0.77

prob.p_jet  = 1.30709e6      # 1.29 atm
prob.T_jet  = 300.0          # K
prob.v_jet  = 1.321e5        # 1321 m/s -> M ~ 1.0, mdot = 0.109 g/s
prob.jet_x  = 4.2            # 42 mm from the inlet
prob.jet_z  = 0.25           # spanwise centre
prob.jet_d  = 0.1            # 1 mm diameter
prob.jet_start = 0.0
prob.jet_ramp  = 1.0e-5      # soften the injector start-up transient

eb2.geom_type = "all_regular"
