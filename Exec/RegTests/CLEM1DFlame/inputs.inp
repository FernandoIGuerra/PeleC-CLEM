# ============================================================
#  CLEM 1D premixed flame  --  accuracy test
#  Stabilized (stationary) freely-propagating flame.
#  phi = 0.4 H2/air, LiDryer, p = 1 atm, Tu = 298 K
#  Reference S_L ~ 22.8 cm/s (LiDryer_H2_p1_phi0_4000tu0300.dat)
#
#  Procedure: run, watch the flame front; if it drifts, retune
#  prob.u_in (front moves upstream -> u_in too low; downstream ->
#  too high) until stationary.  Then u_in = S_L and the steady
#  profiles give thickness and burning rate (see postprocess.py).
# ============================================================

# ------------------  TIME / STEP CONTROL  -------------------
stop_time = 0.10
max_step  = 1000

# ------------------  GEOMETRY (quasi-1D)  -------------------
geometry.is_periodic = 0 1            # transverse periodic -> effectively 1D
geometry.coord_sys   = 0
geometry.prob_lo     =   0.0     0.0
geometry.prob_hi     =   0.8     0.0125
amr.n_cell           =   256     4

# ------------------  BOUNDARY CONDITIONS  -------------------
# Hard = inflow (Dirichlet via bcnormal), FOExtrap = outflow
pelec.lo_bc       =  "Hard"     "Interior"
pelec.hi_bc       =  "FOExtrap" "Interior"

# ------------------  PHYSICS  ------------------------------
pelec.do_react        = 1
pelec.chem_integrator = "ReactorCvode"
cvode.solve_type      = GMRES
pelec.do_mol          = 1
pelec.do_hydro        = 1
pelec.diffuse_temp    = 0
pelec.diffuse_enth    = 0
pelec.diffuse_spec    = 0
pelec.diffuse_vel     = 1
pelec.sdc_iters       = 1
pelec.flame_trac_name = HO2

# ------------------  TIME-STEP CONTROL  --------------------
pelec.cfl         = 0.25
pelec.init_shrink = 0.3
pelec.change_max  = 1.1
pelec.dt_cutoff   = 5.e-20

# ------------------  DIAGNOSTICS / VERBOSITY  --------------
pelec.sum_interval = 10 #Usually 1
pelec.v            = 1
amr.v              = 1

# ------------------  REFINEMENT  ---------------------------
amr.max_level       = 0
amr.blocking_factor = 4
amr.max_grid_size   = 64
amr.n_error_buf     = 2 2 2 2

# ------------------  CHECKPOINTS  --------------------------
amr.checkpoint_files_output = 0
amr.check_file              = chk
amr.check_int               = 5000

# ------------------  PLOTFILES  ---------------------------
amr.plot_files_output = 1
amr.plot_file         = CurrentResults/pltFlameCorrection_
amr.plot_int          = 250
amr.derive_plot_vars  = density xmom eden Temp pressure x_velocity
pelec.plot_rhoy       = 0
pelec.plot_massfrac   = 1

# ------------------  PROBLEM PARAMETERS  ------------------
# Whole domain is initialized from the reference flame profile, so the flame
# starts at its correct thickness/structure/velocity (cold-end u = S_L is also
# the Hard inflow at x-lo). standoff is auto-set so the reference front lands
# at x = x_flame; override prob.standoff to move it.
prob.p_amb        = 1013250.0
prob.pmf_datafile = "LiDryer_H2_p1_phi0_4000tu0300.dat"
prob.x_flame      = 0.35

amrex.signal_handling = 0
#prob.standoff = 0.0
