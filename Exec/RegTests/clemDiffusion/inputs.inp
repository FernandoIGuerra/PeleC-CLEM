# ------------------  INPUTS TO MAIN PROGRAM  -------------------
stop_time = 0.1
max_step = 2000

# PROBLEM SIZE & GEOMETRY
geometry.is_periodic = 0 0
geometry.coord_sys   = 0  # 0 => cart, 1 => RZ  2=>spherical
geometry.prob_lo     =   0.0  0.0  
geometry.prob_hi     =   1.0  0.125 
amr.n_cell           =   160   20   

# >>>>>>>>>>>>>  BC KEYWORDS <<<<<<<<<<<<<<<<<<<<<<
# Interior, UserBC, Symmetry, SlipWall, NoSlipWall
# >>>>>>>>>>>>>  BC KEYWORDS <<<<<<<<<<<<<<<<<<<<<<
pelec.lo_bc       =  "FOExtrap" "SlipWall" "Interior"
pelec.hi_bc       = "FOExtrap" "SlipWall" "Interior"

# WHICH PHYSICS
pelec.do_react = 1
pelec.chem_integrator = "ReactorCvode"
cvode.solve_type = GMRES
pelec.do_mol = 1
pelec.do_hydro = 1
pelec.diffuse_temp = 1
pelec.diffuse_enth = 1
pelec.diffuse_spec = 1
pelec.diffuse_vel = 1
pelec.sdc_iters = 1
pelec.flame_trac_name = HO2

# TIME STEP CONTROL
pelec.cfl            = 0.25     # cfl number for hyperbolic system
pelec.init_shrink    = 0.3     # scale back initial timestep
pelec.change_max     = 1.1     # scale back initial timestep
pelec.dt_cutoff      = 5.e-20  # level 0 timestep below which we halt

# DIAGNOSTICS & VERBOSITY
pelec.sum_interval = 1       # coarse time steps between computing mass on domain
pelec.v            = 1       # verbosity in PeleC cpp files
amr.v              = 1       # verbosity in Amr.cpp
#amr.grid_log       = grdlog  # name of grid logging file

# REFINEMENT / REGRIDDING
amr.max_level       = 0       # maximum level number allowed
#amr.ref_ratio       = 2 2 2 2 # refinement ratio
#amr.regrid_int      = 2 2 2 2 # how often to regrid
amr.blocking_factor = 4       # block factor in grid generation
amr.max_grid_size   = 4
amr.n_error_buf     = 2 2 2 2 # number of buffer cells in error est

# CHECKPOINT FILES
amr.checkpoint_files_output = 0
amr.check_file              = chk    # root name of checkpoint file
amr.check_int               = 500    # number of timesteps between checkpoints

# PLOTFILES
amr.plot_files_output = 1
amr.plot_file         = Outflow/plt_     # root name of plotfile
amr.plot_int          = 200     # number of timesteps between plotfiles
amr.derive_plot_vars = density xmom ymom zmom eden Temp pressure x_velocity y_velocity
pelec.plot_rhoy = 0
pelec.plot_massfrac = 1

# PROBLEM PARAMETERS
prob.p_init    = 1013250.0
prob.Y_H2_C = 0.06
prob.Y_O2_C = 0.50
prob.Y_N2_C = 0.44
prob.T_C    = 300.0

prob.Y_H2_H = 0.06
prob.Y_O2_H = 0.5
prob.Y_N2_H = 0.44
prob.T_H    = 1000.0


prob.xlimh = 0.6
prob.xliml = 0.4 

# TAGGING
tagging.max_ftracerr_lev = 4
tagging.ftracerr = 150e-6

amrex.signal_handling=0
#amrex.throw_handling=0
